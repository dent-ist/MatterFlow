<?xml version="1.0" encoding="utf-8"?>
<!--
  MatterFlow IIS site configuration (ASP.NET Core Module V2, in-process). Copied into the publish output as web.config.
  Prerequisites (docs/runbook.md section 5):
    * .NET 10 ASP.NET Core Hosting Bundle installed (installs the module; run `iisreset` afterwards).
    * IIS feature Windows Authentication (Web-Windows-Auth) installed. Anonymous Authentication may be installed but must be OFF.
    * The "authentication" section below is locked at server level by default (overrideModeDefault="Deny"). Either unlock it once
      (IIS Manager > server > Configuration Editor > system.webServer/security/authentication/windowsAuthentication and
      anonymousAuthentication > Unlock Section) or set the two switches in IIS Manager > site > Authentication; the result is the same.
  Do not add security headers here: the API sends HSTS, CSP, X-Content-Type-Options, X-Frame-Options, Referrer-Policy and
  Permissions-Policy itself. Do not enable IIS compression: the API compresses static text assets itself and deliberately leaves API JSON uncompressed.
  Upgrades overwrite this file; exclude web.config from the copy when it has local edits (docs/runbook.md section 7).
  AllowedHosts is not set here: it lives in appsettings.Production.json (the API answers 400 for any other host name).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- In-process: the API runs inside the IIS worker process under the app pool identity. -->
      <aspNetCore processPath="dotnet"
                  arguments=".\MatterFlow.Api.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  startupTimeLimit="120"
                  shutdownTimeLimit="30">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <!-- Windows (Negotiate/Kerberos) sign-in for everything, including the static files. Anonymous is off. -->
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true" />
        </authentication>
        <requestFiltering removeServerHeader="true">
          <!-- 12 MB = 12582912 bytes, the email upload ceiling. The API itself caps every other request body at 2 MB. -->
          <requestLimits maxAllowedContentLength="12582912" />
        </requestFiltering>
      </security>

      <!-- The application compresses text assets (gzip/brotli); IIS must not compress them a second time. -->
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>

      <!-- WebDAV would intercept PUT and DELETE before the application sees them. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>

      <!--
        Optional: redirect plain HTTP to HTTPS (needs the IIS URL Rewrite module). Alternatively bind only port 443.
        <rewrite>
          <rules>
            <rule name="HttpsRedirect" stopProcessing="true">
              <match url="(.*)" />
              <conditions><add input="{HTTPS}" pattern="off" /></conditions>
              <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
            </rule>
          </rules>
        </rewrite>
      -->
    </system.webServer>
  </location>
</configuration>
