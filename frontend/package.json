{
  "name": "matterflow-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "start:api": "ng serve --configuration api",
    "watch": "ng build --watch --configuration development",
    "test": "ng test frontend --watch=false && ng test form-engine --watch=false",
    "lint": "eslint \"{src,projects}/**/*.{ts,html}\"",
    "api:generate": "nswag run nswag.json",
    "format:check": "prettier --check \"{src,projects,e2e}/**/*.{ts,html,scss}\"",
    "e2e": "bash e2e/run-local.sh",
    "e2e:run": "playwright test -c e2e/playwright.config.ts",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^3.0.1",
    "primeicons": "^8.0.2",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.5",
    "angular-eslint": "^21.4.0",
    "axe-core": "4.10.2",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "nswag": "14.7.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  }
}
