<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Build-time OpenAPI generation writes the committed contract; CI fails if regenerating changes it. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\..\contracts\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The SME starter configuration is the single source for the optional startup seed (Seed:StarterConfiguration). -->
    <EmbeddedResource Include="..\..\..\docs\sme\seed-configuration.json" LogicalName="MatterFlow.Seed.seed-configuration.json" Link="Seeding\seed-configuration.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MatterFlow.SharedKernel\MatterFlow.SharedKernel.csproj" />
    <ProjectReference Include="..\MatterFlow.Data\MatterFlow.Data.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.Identity\MatterFlow.Identity.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.Audit\MatterFlow.Audit.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.Configuration\MatterFlow.Configuration.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.Organization\MatterFlow.Organization.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.Assets\MatterFlow.Assets.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.WorkflowEngine\MatterFlow.WorkflowEngine.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.WorkManagement\MatterFlow.WorkManagement.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.WorkViews\MatterFlow.WorkViews.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.Search\MatterFlow.Search.csproj" />
    <ProjectReference Include="..\Modules\MatterFlow.Intake\MatterFlow.Intake.csproj" />
  </ItemGroup>
</Project>
