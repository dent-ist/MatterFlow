<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Build-time OpenAPI generation writes the committed contract; CI fails if regenerating changes it. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\..\contracts\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The SME starter configuration is the single source for the optional startup seed (Seed:StarterConfiguration). -->
    <EmbeddedResource Include="..\..\..\docs\sme\seed-configuration.json" LogicalName="LptHub.Seed.seed-configuration.json" Link="Seeding\seed-configuration.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LptHub.SharedKernel\LptHub.SharedKernel.csproj" />
    <ProjectReference Include="..\LptHub.Data\LptHub.Data.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Identity\LptHub.Identity.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Audit\LptHub.Audit.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Configuration\LptHub.Configuration.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Organization\LptHub.Organization.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Assets\LptHub.Assets.csproj" />
    <ProjectReference Include="..\Modules\LptHub.WorkflowEngine\LptHub.WorkflowEngine.csproj" />
    <ProjectReference Include="..\Modules\LptHub.WorkManagement\LptHub.WorkManagement.csproj" />
    <ProjectReference Include="..\Modules\LptHub.WorkViews\LptHub.WorkViews.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Search\LptHub.Search.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Intake\LptHub.Intake.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Notifications\LptHub.Notifications.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Notes\LptHub.Notes.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Productions\LptHub.Productions.csproj" />
    <ProjectReference Include="..\Modules\LptHub.Reports\LptHub.Reports.csproj" />
  </ItemGroup>
</Project>
