<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\MatterFlow.SharedKernel\MatterFlow.SharedKernel.csproj" />
    <ProjectReference Include="..\MatterFlow.Reports.Contracts\MatterFlow.Reports.Contracts.csproj" />
    <ProjectReference Include="..\MatterFlow.Identity.Contracts\MatterFlow.Identity.Contracts.csproj" />
    <ProjectReference Include="..\MatterFlow.Audit.Contracts\MatterFlow.Audit.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MatterFlow.UnitTests" />
    <InternalsVisibleTo Include="MatterFlow.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
  </ItemGroup>
  <ItemGroup>
    <!-- The access catalogue of the report login (script 30): the startup probe and the schema browser need the same allow/deny list as the database. -->
    <EmbeddedResource Include="..\..\..\..\db\report-access.json" LogicalName="db.report-access.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The starter reports (issue #724): one SQL file per report plus a manifest, read by ReportStarterSeeder. -->
    <EmbeddedResource Include="Starters\manifest.json" LogicalName="MatterFlow.Reports.Starters.manifest.json" />
    <EmbeddedResource Include="Starters\*.sql" LogicalName="MatterFlow.Reports.Starters.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
