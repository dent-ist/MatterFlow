<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\LptHub.SharedKernel\LptHub.SharedKernel.csproj" />
    <ProjectReference Include="..\LptHub.Reports.Contracts\LptHub.Reports.Contracts.csproj" />
    <ProjectReference Include="..\LptHub.Identity.Contracts\LptHub.Identity.Contracts.csproj" />
    <ProjectReference Include="..\LptHub.Audit.Contracts\LptHub.Audit.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LptHub.UnitTests" />
    <InternalsVisibleTo Include="LptHub.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
  </ItemGroup>
  <ItemGroup>
    <!-- The access catalogue of the report login (script 30): the startup probe and the schema browser need the same allow/deny list as the database. -->
    <EmbeddedResource Include="..\..\..\..\db\report-access.json" LogicalName="db.report-access.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The starter reports (issue #724): one SQL file per report plus a manifest, read by ReportStarterSeeder. -->
    <EmbeddedResource Include="Starters\manifest.json" LogicalName="LptHub.Reports.Starters.manifest.json" />
    <EmbeddedResource Include="Starters\*.sql" LogicalName="LptHub.Reports.Starters.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
