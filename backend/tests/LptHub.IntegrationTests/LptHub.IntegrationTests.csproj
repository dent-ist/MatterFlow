  </ItemGroup>
  <ItemGroup>
    <!-- Email fixtures of the Outlook drag-and-drop spike, linked and never forked. -->
    <None Include="..\..\..\tools\spike-outlook-dnd\samples\*.eml" Link="Intake\samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
